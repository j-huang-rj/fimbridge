# ==========================
# BASE
# ==========================

UPSTREAM_BASE=http://127.0.0.1:11434
LISTEN_HOST=127.0.0.1
LISTEN_PORT=11435


# ==========================
# WORKER
# ==========================

WORKER_IDLE_TTL_S=300
REAPER_INTERVAL_S=30


# ==========================
# ADAPTIVE DEBOUNCE
# ==========================

DEBOUNCE_BASE_MS=50
DEBOUNCE_MIN_MS=20
DEBOUNCE_MAX_MS=200
DEBOUNCE_STEP_MS=20
DEBOUNCE_EMA_ALPHA=0.35

LATENCY_HIGH_S=0.6
LATENCY_LOW_S=0.3


# ==========================
# UPSTREAM TIMEOUTS
# ==========================

UPSTREAM_CONNECT_TIMEOUT=1.0
UPSTREAM_WRITE_TIMEOUT=5.0
UPSTREAM_READ_TIMEOUT=15.0
UPSTREAM_POOL_TIMEOUT=5.0


# ==========================
# CIRCUIT BREAKER
# ==========================

CB_THRESHOLD=3
CB_COOLDOWN_S=5.0
CB_HALF_OPEN_PROBES=1


# ==========================
# FIM DIALECT TRANSLATION
# ==========================

FIM_SOURCE_PREFIX="<fim_prefix>"
FIM_SOURCE_SUFFIX="<fim_suffix>"
FIM_SOURCE_MIDDLE="<fim_middle>"

FIM_TARGET_PREFIX="<|fim_prefix|>"
FIM_TARGET_SUFFIX="<|fim_suffix|>"
FIM_TARGET_MIDDLE="<|fim_middle|>"
